# ═══════════ 数据库 / 缓存 ═══════════
DATABASE_URL=postgres://user:pass@host:5432/castle_siege?sslmode=require
REDIS_URL=redis://default:pass@host:6379

# ═══════════ 安全 ═══════════
# JWT 签名密钥（至少 32 字符随机串）
JWT_SECRET=
# API Key 加密密钥：openssl rand -base64 32 生成（必须 32 字节 Base64）
MODEL_ENC_KEY=
# 验证码 HMAC 加盐（可选，默认回退 JWT_SECRET）
CODE_PEPPER=

# ═══════════ 模型 ═══════════
# 是否允许本地模型地址（Ollama 等），默认 false
ALLOW_LOCAL_MODEL_URL=false
DEFAULT_MODEL_BASE_URL=https://api.deepseek.com/v1
DEFAULT_MODEL_KEY=
DEFAULT_MODEL_NAME=deepseek-chat

# ═══════════ 邮件（QQ 邮箱 SMTP）═══════════
# 发件邮箱
QQ_SMTP_USER=
# 授权码（16 位，非登录密码）
QQ_SMTP_CODE=
# 仅本地开发：true 且未配置上面两项时，验证码直接由接口返回（devCode）并打印到服务器日志。
# 必须同时满足 NODE_ENV !== 'production' 才生效；公开环境请留空或设 false。
MAIL_DEV_LOG=false

# ═══════════ 应用 ═══════════
APP_URL=http://localhost:3000
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999
